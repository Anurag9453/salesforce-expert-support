{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "packages/config/**"],
  "globalEnv": ["NODE_ENV", "CI"],
  // Settings an operator tunes from the shell rather than from .env. Turbo
  // strips anything not listed here, so without these a
  // `HEARTBEAT_STALE_AFTER_SECONDS=10 pnpm dev` silently keeps the 180s
  // default — which looks exactly like a broken sweep.
  "globalPassThroughEnv": [
    "ABLY_API_KEY",
    "ANTHROPIC_API_KEY",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CI",
    "CLASSIFIER_MODEL",
    "CLASSIFIER_PROVIDER",
    "CLASSIFIER_TIMEOUT_MS",
    "CRM_PROVIDER",
    "CRON_SECRET",
    "DAILY_API_KEY",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "DISPATCH_MODE",
    "ENV_FILE",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "HEARTBEAT_INTERVAL_SECONDS",
    "HEARTBEAT_STALE_AFTER_SECONDS",
    "INTAKE_MODE",
    "INTEREST_BROADCAST_SIZE",
    "INTEREST_WINDOW_SECONDS",
    "LOG_LEVEL",
    "MAILER_PROVIDER",
    "MAIL_FROM",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NODE_ENV",
    "OFFER_WINDOW_SECONDS",
    "PAYMENT_PROVIDER",
    "PAYOUT_PROVIDER",
    "REALTIME_PROVIDER",
    "RELAXATION_SCHEDULE_SECONDS",
    "RESEND_API_KEY",
    "SALESFORCE_CLIENT_ID",
    "SALESFORCE_CLIENT_SECRET",
    "SALESFORCE_INSTANCE_URL",
    "SALESFORCE_LEAD_EXTERNAL_ID_FIELD",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "SKIP_DB_TESTS",
    "STORAGE_ACCESS_KEY_ID",
    "STORAGE_BUCKET",
    "STORAGE_ENDPOINT",
    "STORAGE_REGION",
    "STORAGE_SECRET_ACCESS_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VIDEO_PROVIDER",
    "WORKER_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    /*
      `prisma generate` cannot be cached, because what it produces does not live
      where Turbo can see it.

      It writes the generated client into `node_modules/.pnpm/@prisma+client@…/
      node_modules/.prisma/client`, outside the package entirely, so no `outputs`
      glob can capture it. Turbo then does the worst possible thing on a cache
      hit: it skips the work *and* restores nothing, leaving a machine that
      believes the client was generated when no client exists.

      That is not theoretical. A Vercel build failed with

          Type error: Parameter 'row' implicitly has an 'any' type
          apps/web/app/(app)/admin/requests/page.tsx:78

      one line above `@sfx/db:build: cache hit, replaying logs`. The parameter is
      implicitly `any` because `prisma.supportRequest.findMany()` is typed by the
      generated client — and there wasn't one. The error named a React component,
      three layers from the cause.

      Generation takes about a third of a second. There is nothing to save here.
    */
    "@sfx/db#build": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
