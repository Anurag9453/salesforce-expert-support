{
  "name": "@sfx/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv --no-expand -e ${ENV_FILE:-../../.env} -- prisma migrate dev",
    "migrate:deploy": "dotenv --no-expand -e ${ENV_FILE:-../../.env} -- prisma migrate deploy",
    "migrate:fresh": "dotenv --no-expand -e ${ENV_FILE:-../../.env} -- node scripts/assert-local-target.mjs && dotenv --no-expand -e ${ENV_FILE:-../../.env} -- prisma migrate reset --force --skip-seed",
    "studio": "dotenv --no-expand -e ${ENV_FILE:-../../.env} -- prisma studio",
    "seed": "dotenv --no-expand -e ${ENV_FILE:-../../.env} -- tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate",
    "clean": "rm -rf .turbo node_modules/.prisma",
    "assert-schema": "dotenv --no-expand -e ${ENV_FILE:-../../.env} -- node scripts/assert-schema.mjs",
    "grant-role": "dotenv --no-expand -e ${ENV_FILE:-../../.env} -- node scripts/grant-role.mjs",
    "migrate:status": "dotenv --no-expand -e ${ENV_FILE:-../../.env} -- prisma migrate status"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@sfx/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "dotenv-cli": "^8.0.0"
  }
}
