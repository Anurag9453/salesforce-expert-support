# ─── Phase 1: required ────────────────────────────────────────────────────────
#
# Three database URLs, because three jobs want different things from a connection.
# Locally they are all the same string: `pnpm pg:start` runs an embedded Postgres
# on port 55432 with no pooler in front of it, so there is nothing to route around.
#
#   DATABASE_URL         pooled   — ordinary queries from the web app
#   DIRECT_DATABASE_URL  unpooled — Prisma Migrate, and the realtime LISTEN
#   WORKER_DATABASE_URL  unpooled — the always-on worker (pg-boss)
#
# On a managed provider the pooled and unpooled URLs differ by port and host.
# Supabase, for example, uses 6543 for the transaction pooler and 5432 direct;
# append `?pgbouncer=true&connection_limit=1` to the pooled one for Prisma.
#
# Getting this wrong does not fail loudly. A transaction pooler hands each
# statement to whichever backend is free, so a LISTEN lands on a connection
# nobody notifies and pg-boss just goes quiet.
DATABASE_URL="postgresql://sfx:sfx_local_dev@localhost:55432/sfx"
DIRECT_DATABASE_URL="postgresql://sfx:sfx_local_dev@localhost:55432/sfx"
WORKER_DATABASE_URL="postgresql://sfx:sfx_local_dev@localhost:55432/sfx"

# ── Pointing a command at a different database ────────────────────────────────
#
# Every database script reads `${ENV_FILE:-../../.env}`, resolved from
# `packages/db`. Nothing is hardcoded to this file any more, so a deployed
# database can be migrated without editing a package.json:
#
#     pnpm db:remote:preflight     # read-only checks before anything is applied
#     pnpm db:remote:status        # what is pending, and against which host
#     pnpm db:remote:deploy        # prisma migrate deploy
#     pnpm db:remote:seed
#     pnpm db:remote:verify        # structural diff against local
#
# Those wrap `ENV_FILE=../../.env.supabase`. For any other target, set ENV_FILE
# yourself — and note it is relative to `packages/db`, not the repository root.
#
# `db:migrate:fresh` is the exception: it runs `prisma migrate reset --force`,
# and refuses outright unless DATABASE_URL points at localhost. Making the target
# configurable is exactly what made that guard necessary.
#
# See .env.vercel.example for what production needs, which is not the same shape:
# the IPv6-only direct endpoint is unreachable from Vercel, and transaction-mode
# pooling silently breaks LISTEN.

# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-at-least-32-characters-of-entropy"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Phase 2: Google sign-in (both, or neither) ───────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ─── Phase 3: attachments (Cloudflare R2 / any S3-compatible) ─────────────────
# STORAGE_BUCKET=""
# STORAGE_ENDPOINT=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""

# ─── Phase 3: problem classification ──────────────────────────────────────────
# Starts on Haiku 4.5 and stays configurable so the promotion evaluation can run
# a comparative sample without a code change. `mock` needs no API key.
CLASSIFIER_PROVIDER="mock"
CLASSIFIER_MODEL="claude-haiku-4-5"
# ANTHROPIC_API_KEY=""

# ─── Phase 4: expert presence ─────────────────────────────────────────────────
# The dashboard pings every HEARTBEAT_INTERVAL_SECONDS while available. If
# nothing arrives for HEARTBEAT_STALE_AFTER_SECONDS the worker sweeps the expert
# offline, and they stay offline until they explicitly go available again.
# The interval must be shorter than the window, or every present expert is swept.
# Drop the window to ~20s to watch a sweep happen without waiting three minutes.
HEARTBEAT_INTERVAL_SECONDS="45"
HEARTBEAT_STALE_AFTER_SECONDS="180"

# ─── Phase 5: matching ────────────────────────────────────────────────────────
# How long an expert has to answer an offer (§Q6 chose 60s). Shorten it to watch
# the timeout path without waiting a minute; the deadline is stored per offer, so
# changing it never affects an offer already open.
OFFER_WINDOW_SECONDS="60"

# When each relaxation level becomes available, in seconds from submission.
# 0,90,180,360 inside a 15-minute deadline — tuned for a small launch roster,
# where a thin bench runs out of level-0 candidates in seconds. Tuning this
# changes how SOON the search widens, never how FAR: the primary-skill
# competence floor is enforced separately and is not configurable.
RELAXATION_SCHEDULE_SECONDS="0,90,180,360"

# ─── Phase 6: realtime ────────────────────────────────────────────────────────
# `postgres` uses LISTEN/NOTIFY over the connection you already have — no signup,
# no API key, no second failure domain. It needs a process that can hold a
# long-lived connection, so a serverless deployment wants a hosted provider
# instead (the RealtimeBus port exists for exactly that swap).
#
# `mock` delivers nothing, which is a runnable demonstration that dispatch does
# not depend on delivery: every offer is still created, still expires on time,
# and is still visible on the dashboard.
REALTIME_PROVIDER="postgres"
# ABLY_API_KEY=""

# ─── Phase 7a/7b: payments & payouts ──────────────────────────────────────────
# Providers undecided until Q3 (entity + customer geography + expert geography).
# Both ports run on mocks through Phase 6, which still exercises the full
# authorize-before-matching flow.
PAYMENT_PROVIDER="mock"
PAYOUT_PROVIDER="mock"

# ─── Phase 8: video ───────────────────────────────────────────────────────────
VIDEO_PROVIDER="mock"
# DAILY_API_KEY=""

# ─── Email ────────────────────────────────────────────────────────────────────
MAILER_PROVIDER="mock"
MAIL_FROM="noreply@example.com"
# RESEND_API_KEY=""

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL="info"
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# ─── CRM: Salesforce (lead capture) ───────────────────────────────────────────
# Where a captured enquiry goes. `mock` logs instead of pushing, which is what
# every test and every local run should use.
#
# The real values come from a Connected App using the Client Credentials flow.
# Never commit them: put them in `.env`, which is gitignored, or in the hosting
# platform's own secret store.
CRM_PROVIDER="mock"
# CRM_PROVIDER="salesforce"
# SALESFORCE_INSTANCE_URL="https://your-org.my.salesforce.com"
# SALESFORCE_CLIENT_ID="your-connected-app-consumer-key"
# SALESFORCE_CLIENT_SECRET="your-connected-app-consumer-secret"
# Which External Id field the Lead upsert keys on. Defaults to Customer_Key__c.
# SALESFORCE_LEAD_EXTERNAL_ID_FIELD="Customer_Key__c"
