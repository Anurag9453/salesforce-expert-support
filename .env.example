# ─── Phase 1: required ────────────────────────────────────────────────────────
# Local dev uses the embedded Postgres started by `pnpm pg:start` (port 55432).
# It needs no Docker and no system-wide install.
DATABASE_URL="postgresql://sfx:sfx_local_dev@localhost:55432/sfx"
DIRECT_DATABASE_URL="postgresql://sfx:sfx_local_dev@localhost:55432/sfx"

# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-at-least-32-characters-of-entropy"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Phase 2: Google sign-in (both, or neither) ───────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ─── Phase 3: attachments (Cloudflare R2 / any S3-compatible) ─────────────────
# STORAGE_BUCKET=""
# STORAGE_ENDPOINT=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""

# ─── Phase 3: problem classification ──────────────────────────────────────────
# Starts on Haiku 4.5 and stays configurable so the promotion evaluation can run
# a comparative sample without a code change. `mock` needs no API key.
CLASSIFIER_PROVIDER="mock"
CLASSIFIER_MODEL="claude-haiku-4-5"
# ANTHROPIC_API_KEY=""

# ─── Phase 4: expert presence ─────────────────────────────────────────────────
# The dashboard pings every HEARTBEAT_INTERVAL_SECONDS while available. If
# nothing arrives for HEARTBEAT_STALE_AFTER_SECONDS the worker sweeps the expert
# offline, and they stay offline until they explicitly go available again.
# The interval must be shorter than the window, or every present expert is swept.
# Drop the window to ~20s to watch a sweep happen without waiting three minutes.
HEARTBEAT_INTERVAL_SECONDS="45"
HEARTBEAT_STALE_AFTER_SECONDS="180"

# ─── Phase 5: matching ────────────────────────────────────────────────────────
# How long an expert has to answer an offer (§Q6 chose 60s). Shorten it to watch
# the timeout path without waiting a minute; the deadline is stored per offer, so
# changing it never affects an offer already open.
OFFER_WINDOW_SECONDS="60"

# ─── Phase 6: realtime ────────────────────────────────────────────────────────
REALTIME_PROVIDER="mock"
# ABLY_API_KEY=""

# ─── Phase 7a/7b: payments & payouts ──────────────────────────────────────────
# Providers undecided until Q3 (entity + customer geography + expert geography).
# Both ports run on mocks through Phase 6, which still exercises the full
# authorize-before-matching flow.
PAYMENT_PROVIDER="mock"
PAYOUT_PROVIDER="mock"

# ─── Phase 8: video ───────────────────────────────────────────────────────────
VIDEO_PROVIDER="mock"
# DAILY_API_KEY=""

# ─── Email ────────────────────────────────────────────────────────────────────
MAILER_PROVIDER="mock"
MAIL_FROM="noreply@example.com"
# RESEND_API_KEY=""

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL="info"
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
