{
  "name": "@sfx/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@sfx/adapters": "workspace:*",
    "@sfx/contracts": "workspace:*",
    "@sfx/db": "workspace:*",
    "@sfx/domain": "workspace:*",
    "pg-boss": "^10.1.6"
  },
  "devDependencies": {
    "@sfx/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "dotenv-cli": "^8.0.0"
  }
}
